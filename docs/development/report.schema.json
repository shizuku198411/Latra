{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shizuku198411/Latra/blob/main/docs/development/report.schema.json",
  "title": "Latra scan report",
  "description": "Schema for compact and verbose Latra scan reports with schemaVersion 5.",
  "oneOf": [
    { "$ref": "#/$defs/compactReport" },
    { "$ref": "#/$defs/fullReport" }
  ],
  "$defs": {
    "compactReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "scanner", "findingDatabase", "input", "workshops", "summary", "assessment", "diagnostics"],
      "properties": {
        "schemaVersion": { "const": "5" },
        "scanner": { "$ref": "#/$defs/scanner" },
        "findingDatabase": { "$ref": "#/$defs/findingDatabase" },
        "input": { "$ref": "#/$defs/input" },
        "workshops": {
          "type": "array",
          "items": { "$ref": "#/$defs/workshop" }
        },
        "summary": { "$ref": "#/$defs/summary" },
        "assessment": { "$ref": "#/$defs/assessment" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/documentDiagnostic" }
        }
      }
    },
    "fullReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "scanner", "findingDatabase", "input", "summary", "assessment", "workshops", "sdks", "diagnostics"],
      "properties": {
        "schemaVersion": { "const": "5" },
        "scanner": { "$ref": "#/$defs/scanner" },
        "findingDatabase": { "$ref": "#/$defs/findingDatabase" },
        "input": { "$ref": "#/$defs/input" },
        "summary": { "$ref": "#/$defs/summary" },
        "assessment": { "$ref": "#/$defs/assessment" },
        "workshops": {
          "type": "array",
          "items": { "$ref": "#/$defs/workshop" }
        },
        "sdks": {
          "type": "array",
          "items": { "$ref": "#/$defs/sdk" }
        },
        "compositionRelations": {
          "type": "array",
          "items": { "$ref": "#/$defs/compositionRelation" }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/documentDiagnostic" }
        }
      }
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commit", "buildDate"],
      "properties": {
        "name": { "type": "string", "const": "latra" },
        "version": { "type": "string" },
        "commit": { "type": "string" },
        "buildDate": { "type": "string" }
      }
    },
    "findingDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "contentVersion", "source"],
      "properties": {
        "schemaVersion": { "const": "4" },
        "contentVersion": { "type": "string" },
        "source": { "const": "embedded-default" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "root"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["project", "project-sdk"]
        },
        "root": { "type": "string" }
      }
    },
    "workshop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "base", "definition"],
      "properties": {
        "name": { "type": "string" },
        "base": { "type": "string" },
        "runtime": { "type": "string" },
        "definition": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdks", "files", "hooks", "operations", "capabilities", "unknownCommands", "diagnostics", "findings", "observations"],
      "properties": {
        "sdks": { "$ref": "#/$defs/sdkSummary" },
        "files": { "$ref": "#/$defs/fileSummary" },
        "hooks": { "$ref": "#/$defs/hookSummary" },
        "operations": { "$ref": "#/$defs/operationSummary" },
        "capabilities": { "$ref": "#/$defs/capabilitySummary" },
        "unknownCommands": { "$ref": "#/$defs/unknownCommandSummary" },
        "diagnostics": { "$ref": "#/$defs/diagnosticSummary" },
        "findings": { "$ref": "#/$defs/findingSummary" },
        "observations": { "$ref": "#/$defs/observationSummary" }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "reviewPriority", "risk", "assurance", "coverage", "keyRisks", "bySdk"],
      "properties": {
        "classification": { "$ref": "#/$defs/classification" },
        "reviewPriority": { "$ref": "#/$defs/score" },
        "risk": { "$ref": "#/$defs/scoredAxis" },
        "assurance": { "$ref": "#/$defs/scoredAxis" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "keyRisks": {
          "type": "array",
          "items": { "$ref": "#/$defs/riskHighlight" }
        },
        "bySdk": {
          "type": "array",
          "items": { "$ref": "#/$defs/sdkAssessment" }
        }
      }
    },
    "sdkAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdk", "classification", "reviewPriority", "risk", "assurance", "coverage", "keyRisks"],
      "properties": {
        "sdk": { "type": "string" },
        "classification": { "$ref": "#/$defs/classification" },
        "reviewPriority": { "$ref": "#/$defs/score" },
        "risk": { "$ref": "#/$defs/scoredAxis" },
        "assurance": { "$ref": "#/$defs/scoredAxis" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "keyRisks": {
          "type": "array",
          "items": { "$ref": "#/$defs/riskHighlight" }
        }
      }
    },
    "classification": {
      "type": "string",
      "enum": ["expected-and-controlled", "powerful-but-controlled", "weakly-controlled", "high-priority-review", "insufficient-evidence", "requires-semantic-review"]
    },
    "riskHighlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "severity", "score", "occurrences", "scopes"],
      "properties": {
        "id": { "type": "string", "pattern": "^risk\\.[a-z0-9.-]+$" },
        "title": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "occurrences": { "$ref": "#/$defs/nonNegativeInteger" },
        "scopes": {
          "type": "array",
          "items": { "$ref": "#/$defs/riskScope" }
        }
      }
    },
    "riskScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdk"],
      "properties": {
        "sdk": { "type": "string" },
        "hook": { "$ref": "#/$defs/hookName" },
        "location": { "$ref": "#/$defs/location" },
        "valueLocation": { "$ref": "#/$defs/location" },
        "value": { "type": "string" },
        "expression": { "type": "string" },
        "resolution": { "$ref": "#/$defs/resolution" },
        "derivation": { "$ref": "#/$defs/evidenceDerivation" },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/operationRelation" }
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "level"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "level": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] }
      }
    },
    "scoredAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "level", "findings", "families"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "level": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
        "findings": { "$ref": "#/$defs/nonNegativeInteger" },
        "families": {
          "type": "array",
          "items": { "$ref": "#/$defs/familyScore" }
        }
      }
    },
    "familyScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "score", "findings", "cap"],
      "properties": {
        "family": { "type": "string" },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "findings": { "$ref": "#/$defs/nonNegativeInteger" },
        "cap": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "level", "hooks", "commands", "files", "semantics"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "level": { "type": "string", "enum": ["sufficient", "insufficient"] },
        "hooks": { "$ref": "#/$defs/hookCoverage" },
        "commands": { "$ref": "#/$defs/commandCoverage" },
        "files": { "$ref": "#/$defs/fileCoverage" },
        "semantics": { "$ref": "#/$defs/semanticCoverage" }
      }
    },
    "semanticCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "level", "criticalGaps", "dataFlow", "includedSources", "functions", "lifecycle", "composition", "aliases", "gaps"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "level": { "type": "string", "enum": ["sufficient", "insufficient"] },
        "criticalGaps": { "$ref": "#/$defs/nonNegativeInteger" },
        "dataFlow": { "$ref": "#/$defs/semanticDimension" },
        "includedSources": { "$ref": "#/$defs/semanticDimension" },
        "functions": { "$ref": "#/$defs/semanticDimension" },
        "dynamicCommands": { "$ref": "#/$defs/semanticDimension" },
        "lifecycle": { "$ref": "#/$defs/semanticDimension" },
        "composition": { "$ref": "#/$defs/semanticDimension" },
        "aliases": { "$ref": "#/$defs/semanticDimension" },
        "gaps": { "type": "array", "items": { "$ref": "#/$defs/semanticGap" } }
      }
    },
    "semanticDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "resolved", "gaps"],
      "properties": {
        "applicable": { "$ref": "#/$defs/nonNegativeInteger" },
        "resolved": { "$ref": "#/$defs/nonNegativeInteger" },
        "gaps": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "semanticGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "dimension", "severity", "message"],
      "properties": {
        "code": { "type": "string" },
        "dimension": { "type": "string", "enum": ["data-flow", "included-sources", "functions", "dynamic-commands", "lifecycle", "composition", "aliases"] },
        "severity": { "type": "string", "enum": ["warning", "critical"] },
        "hook": { "$ref": "#/$defs/hookName" },
        "operationId": { "type": "string", "pattern": "^op-[0-9]{4,}$" },
        "message": { "type": "string" }
      }
    },
    "hookCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "parsed", "recovered", "failed"],
      "properties": {
        "total": { "$ref": "#/$defs/nonNegativeInteger" },
        "parsed": { "$ref": "#/$defs/nonNegativeInteger" },
        "recovered": { "$ref": "#/$defs/nonNegativeInteger" },
        "failed": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "commandCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "known", "unknown", "unresolved"],
      "properties": {
        "total": { "$ref": "#/$defs/nonNegativeInteger" },
        "known": { "$ref": "#/$defs/nonNegativeInteger" },
        "unknown": { "$ref": "#/$defs/nonNegativeInteger" },
        "unresolved": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "fileCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventoried", "contentAnalyzed", "binaryOnly", "contentSkipped"],
      "properties": {
        "inventoried": { "$ref": "#/$defs/nonNegativeInteger" },
        "contentAnalyzed": { "$ref": "#/$defs/nonNegativeInteger" },
        "binaryOnly": { "$ref": "#/$defs/nonNegativeInteger" },
        "contentSkipped": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "sdkSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "sdkNames", "resolved", "unresolved"],
      "properties": {
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "sdkNames": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolved", "unresolved"],
          "properties": {
            "resolved": { "$ref": "#/$defs/stringArray" },
            "unresolved": { "$ref": "#/$defs/stringArray" }
          }
        },
        "resolved": { "$ref": "#/$defs/nonNegativeInteger" },
        "unresolved": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "fileSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "contentSkipped", "bySdk"],
      "properties": {
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "contentSkipped": { "$ref": "#/$defs/nonNegativeInteger" },
        "bySdk": {
          "type": "array",
          "items": { "$ref": "#/$defs/sdkFileSummary" }
        }
      }
    },
    "sdkFileSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdkName", "count", "contentSkipped", "filePaths", "skippedFiles"],
      "properties": {
        "sdkName": { "type": "string" },
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "contentSkipped": { "$ref": "#/$defs/nonNegativeInteger" },
        "filePaths": { "$ref": "#/$defs/stringArray" },
        "skippedFiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/skippedFileSummary" }
        }
      }
    },
    "skippedFileSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filePath", "size", "digest", "reason"],
      "properties": {
        "filePath": { "type": "string" },
        "size": { "$ref": "#/$defs/nonNegativeInteger" },
        "digest": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "hookSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "bySdk"],
      "properties": {
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "bySdk": {
          "type": "array",
          "items": { "$ref": "#/$defs/sdkHookSummary" }
        }
      }
    },
    "sdkHookSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdkName", "count", "hookNames"],
      "properties": {
        "sdkName": { "type": "string" },
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "hookNames": {
          "type": "array",
          "items": { "$ref": "#/$defs/hookName" }
        }
      }
    },
    "operationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "bySdk"],
      "properties": {
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "bySdk": {
          "type": "array",
          "items": { "$ref": "#/$defs/sdkOperationSummary" }
        }
      }
    },
    "sdkOperationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdkName", "count", "operationKinds"],
      "properties": {
        "sdkName": { "type": "string" },
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "operationKinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/countedName" }
        }
      }
    },
    "capabilitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "bySdk"],
      "properties": {
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "bySdk": {
          "type": "array",
          "items": { "$ref": "#/$defs/sdkCapabilitySummary" }
        }
      }
    },
    "sdkCapabilitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdkName", "count", "capabilityNames"],
      "properties": {
        "sdkName": { "type": "string" },
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "capabilityNames": {
          "type": "array",
          "items": { "$ref": "#/$defs/countedName" }
        }
      }
    },
    "unknownCommandSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "bySdk"],
      "properties": {
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "dynamic": { "$ref": "#/$defs/nonNegativeInteger" },
        "bySdk": {
          "type": "array",
          "items": { "$ref": "#/$defs/sdkUnknownCommandSummary" }
        }
      }
    },
    "sdkUnknownCommandSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdkName", "count", "files"],
      "properties": {
        "sdkName": { "type": "string" },
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "dynamic": { "$ref": "#/$defs/nonNegativeInteger" },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileUnknownCommandSummary" }
        }
      }
    },
    "fileUnknownCommandSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filePath", "count", "commandNames"],
      "properties": {
        "filePath": { "type": "string" },
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "dynamic": { "$ref": "#/$defs/nonNegativeInteger" },
        "commandNames": {
          "type": "array",
          "items": { "$ref": "#/$defs/countedName" }
        },
        "dynamicExpressions": {
          "type": "array",
          "items": { "$ref": "#/$defs/countedName" }
        }
      }
    },
    "diagnosticSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "diagnosticCodes"],
      "properties": {
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "diagnosticCodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/countedName" }
        }
      }
    },
    "findingSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "risk", "assurance", "bySdk"],
      "properties": {
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "risk": { "$ref": "#/$defs/nonNegativeInteger" },
        "assurance": { "$ref": "#/$defs/nonNegativeInteger" },
        "bySdk": {
          "type": "array",
          "items": { "$ref": "#/$defs/sdkFindingSummary" }
        }
      }
    },
    "sdkFindingSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdkName", "count", "risk", "assurance", "findingIds"],
      "properties": {
        "sdkName": { "type": "string" },
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "risk": { "$ref": "#/$defs/nonNegativeInteger" },
        "assurance": { "$ref": "#/$defs/nonNegativeInteger" },
        "findingIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/countedName" }
        }
      }
    },
    "observationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "bySdk"],
      "properties": {
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "bySdk": {
          "type": "array",
          "items": { "$ref": "#/$defs/sdkObservationSummary" }
        }
      }
    },
    "sdkObservationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdkName", "count", "projectAccess"],
      "properties": {
        "sdkName": { "type": "string" },
        "count": { "$ref": "#/$defs/nonNegativeInteger" },
        "projectAccess": { "$ref": "#/$defs/projectAccessSummary" }
      }
    },
    "projectAccessSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reads", "writes", "uniqueReads", "uniqueWrites"],
      "properties": {
        "reads": { "$ref": "#/$defs/nonNegativeInteger" },
        "writes": { "$ref": "#/$defs/nonNegativeInteger" },
        "uniqueReads": { "$ref": "#/$defs/nonNegativeInteger" },
        "uniqueWrites": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "countedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "count"],
      "properties": {
        "name": { "type": "string" },
        "count": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "state", "declarations", "files", "hooks", "findings"],
      "properties": {
        "name": { "type": "string" },
        "source": {
          "type": "string",
          "enum": ["store", "project", "try", "system"]
        },
        "state": { "$ref": "#/$defs/resolutionState" },
        "channel": { "type": "string" },
        "root": { "type": "string" },
        "digest": { "type": "string" },
        "metadataPath": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "declarations": {
          "type": "array",
          "items": { "$ref": "#/$defs/declaration" }
        },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/file" }
        },
        "hooks": {
          "type": "array",
          "items": { "$ref": "#/$defs/hook" }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/sdkDiagnostic" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "lifecycleRelations": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycleRelation" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "version": { "type": "string" },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "base": { "type": "string" },
        "architecture": { "type": "string" },
        "contact": { "$ref": "#/$defs/stringArray" },
        "issues": { "$ref": "#/$defs/stringArray" },
        "sourceCode": { "type": "string" },
        "website": { "type": "string" },
        "license": { "type": "string" },
        "plugs": { "$ref": "#/$defs/freeFormObject" },
        "slots": { "$ref": "#/$defs/freeFormObject" },
        "sdkcraftStartedAt": { "type": "string" },
        "type": { "type": "string" }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "workshop", "order", "base"],
      "properties": {
        "definition": { "type": "string" },
        "workshop": { "type": "string" },
        "order": { "$ref": "#/$defs/nonNegativeInteger" },
        "base": { "type": "string" },
        "channel": { "type": "string" },
        "plugs": { "$ref": "#/$defs/freeFormObject" },
        "slots": { "$ref": "#/$defs/freeFormObject" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "mode", "contentStatus"],
      "properties": {
        "path": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["regular", "directory", "symlink", "other"]
        },
        "mode": { "$ref": "#/$defs/nonNegativeInteger" },
        "size": { "$ref": "#/$defs/nonNegativeInteger" },
        "digest": { "type": "string" },
        "linkTarget": { "type": "string" },
        "content": { "type": "string" },
        "contentEncoding": {
          "type": "string",
          "enum": ["utf-8", "sha3-384"]
        },
        "contentStatus": {
          "type": "string",
          "enum": ["analyzed", "binary-only", "skipped", "not-applicable"]
        },
        "skipReason": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "regular" } },
            "required": ["type"]
          },
          "then": { "required": ["content", "contentEncoding"] }
        },
        {
          "if": {
            "properties": { "contentStatus": { "const": "skipped" } },
            "required": ["contentStatus"]
          },
          "then": { "required": ["skipReason", "digest"] }
        }
      ]
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "digest", "size", "operations", "relations", "capabilities"],
      "properties": {
        "name": { "$ref": "#/$defs/hookName" },
        "path": { "type": "string" },
        "digest": { "type": "string" },
        "size": { "$ref": "#/$defs/nonNegativeInteger" },
        "parse": { "$ref": "#/$defs/parse" },
        "context": { "$ref": "#/$defs/hookContext" },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/operation" }
        },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/operationRelation" }
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/capability" }
        }
      }
    },
    "parse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recovered", "nodeTypes", "diagnostics"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["Parsed", "Recovered", "Failed"]
        },
        "recovered": { "type": "boolean" },
        "nodeTypes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nonNegativeInteger" }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/parseDiagnostic" }
        }
      }
    },
    "parseDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "location"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "$ref": "#/$defs/severity" },
        "message": { "type": "string" },
        "location": { "$ref": "#/$defs/location" },
        "incomplete": { "type": "boolean" }
      }
    },
    "hookContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "runAsRoot", "projectMounted", "interfacesActive", "stateMounted"],
      "properties": {
        "name": { "$ref": "#/$defs/hookName" },
        "runAsRoot": { "type": "boolean" },
        "projectMounted": { "type": "boolean" },
        "interfacesActive": { "type": "boolean" },
        "stateMounted": { "type": "boolean" },
        "contextDependent": { "type": "boolean" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "kind", "resolution", "location"],
      "properties": {
        "id": { "type": "string", "pattern": "^op-[0-9]{4,}$" },
        "parentId": { "type": "string", "pattern": "^op-[0-9]{4,}$" },
        "sequence": { "$ref": "#/$defs/nonNegativeInteger" },
        "kind": { "$ref": "#/$defs/operationKind" },
        "command": { "$ref": "#/$defs/value" },
        "name": { "type": "string" },
        "wrappers": { "$ref": "#/$defs/stringArray" },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/value" }
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataReference" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataReference" }
        },
        "resolution": { "$ref": "#/$defs/resolution" },
        "reachability": { "$ref": "#/$defs/reachability" },
        "location": { "$ref": "#/$defs/location" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/operation" }
        },
        "include": { "$ref": "#/$defs/includedSource" }
      }
    },
    "operationRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fromOperationId", "toOperationId", "resolution"],
      "properties": {
        "kind": {
          "type": "string",
            "enum": [
              "contains",
              "sequence",
              "pipeline",
              "substitution-flow",
              "variable-flow",
              "redirect-flow",
              "call",
              "argument-flow",
              "include",
              "collection-flow",
              "artifact-flow",
              "alias"
            ]
        },
        "fromOperationId": { "type": "string", "pattern": "^op-[0-9]{4,}$" },
        "toOperationId": { "type": "string", "pattern": "^op-[0-9]{4,}$" },
        "name": { "type": "string" },
        "resolution": { "$ref": "#/$defs/resolution" },
        "artifact": { "$ref": "#/$defs/value" },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance" }
        },
        "digest": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resolution"],
      "properties": {
        "kind": { "type": "string" },
        "sourceOperations": {
          "type": "array",
          "items": { "type": "string", "pattern": "^op-[0-9]{4,}$" }
        },
        "paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/value" }
        },
        "resolution": { "$ref": "#/$defs/resolution" }
      }
    },
    "includedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "from"],
      "properties": {
        "path": { "type": "string" },
        "digest": { "type": "string" },
        "from": { "$ref": "#/$defs/location" }
      }
    },
    "dataReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string" },
        "value": { "$ref": "#/$defs/value" }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution"],
      "properties": {
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/valuePart" }
        },
        "resolution": { "$ref": "#/$defs/resolution" },
        "literal": { "type": "string" },
        "candidates": { "$ref": "#/$defs/stringArray" }
      }
    },
    "valuePart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "literal",
            "quoted-literal",
            "variable-reference",
            "command-substitution",
            "arithmetic-expansion",
            "glob",
            "unknown-expansion"
          ]
        },
        "text": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ruleId", "ruleSource", "operation", "resolution", "location"],
      "properties": {
        "kind": { "type": "string" },
        "ruleId": { "type": "string" },
        "ruleSource": { "type": "string" },
        "operation": { "$ref": "#/$defs/operationKind" },
        "operationId": { "type": "string", "pattern": "^op-[0-9]{4,}$" },
        "target": { "$ref": "#/$defs/value" },
        "resolution": { "$ref": "#/$defs/resolution" },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "startLine", "startColumn", "endLine", "endColumn"],
      "properties": {
        "path": { "type": "string" },
        "startLine": { "$ref": "#/$defs/nonNegativeInteger" },
        "startColumn": { "$ref": "#/$defs/nonNegativeInteger" },
        "endLine": { "$ref": "#/$defs/nonNegativeInteger" },
        "endColumn": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "family", "title", "confidence", "weight", "scope", "evidence", "message"],
      "properties": {
        "id": { "type": "string", "pattern": "^(risk|assurance|observation)\\.[a-z0-9.-]+$" },
        "kind": { "type": "string", "enum": ["risk", "assurance", "observation"] },
        "family": { "type": "string" },
        "title": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
        "strength": { "type": "string", "enum": ["info", "low", "medium", "high"] },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "weight": { "type": "integer", "minimum": 0, "maximum": 100 },
        "scope": { "$ref": "#/$defs/findingScope" },
        "context": { "$ref": "#/$defs/findingContext" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/findingEvidence" }
        },
        "message": { "type": "string" },
        "remediation": { "type": "string" },
        "protectsAgainst": { "$ref": "#/$defs/stringArray" },
        "limitations": { "$ref": "#/$defs/stringArray" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "risk" } } }, "then": { "required": ["severity"] } },
        { "if": { "properties": { "kind": { "const": "assurance" } } }, "then": { "required": ["strength"] } }
      ]
    },
    "findingScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdk"],
      "properties": {
        "sdk": { "type": "string" },
        "hook": { "$ref": "#/$defs/hookName" }
      }
    },
    "findingContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runAsRoot", "projectMounted", "interfacesActive", "stateMounted"],
      "properties": {
        "runAsRoot": { "type": "boolean" },
        "projectMounted": { "type": "boolean" },
        "interfacesActive": { "type": "boolean" },
        "stateMounted": { "type": "boolean" }
      }
    },
    "findingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "sdk": { "type": "string" },
        "type": { "type": "string", "enum": ["operation", "capability", "context", "data-flow", "control-flow", "artifact-flow", "lifecycle-flow", "composition-flow", "include", "alias", "file", "metadata", "diagnostic"] },
        "id": { "type": "string" },
        "operationId": { "type": "string", "pattern": "^op-[0-9]{4,}$" },
        "fromOperationId": { "type": "string", "pattern": "^op-[0-9]{4,}$" },
        "toOperationId": { "type": "string", "pattern": "^op-[0-9]{4,}$" },
        "value": { "type": "string" },
        "expression": { "type": "string" },
        "normalizedValue": { "type": "string" },
        "normalizedCandidates": { "$ref": "#/$defs/stringArray" },
        "resolution": { "$ref": "#/$defs/resolution" },
        "derivation": { "$ref": "#/$defs/evidenceDerivation" },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/operationRelation" }
        },
        "location": { "$ref": "#/$defs/location" },
        "valueLocation": { "$ref": "#/$defs/location" }
      }
    },
    "lifecycleRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fromHook", "toHook", "fromOperationId", "toOperationId", "statePath", "resolution"],
      "properties": {
        "kind": { "const": "state-flow" },
        "fromHook": { "$ref": "#/$defs/hookName" },
        "toHook": { "$ref": "#/$defs/hookName" },
        "fromOperationId": { "type": "string", "pattern": "^op-[0-9]{4,}$" },
        "toOperationId": { "type": "string", "pattern": "^op-[0-9]{4,}$" },
        "statePath": { "$ref": "#/$defs/value" },
        "resolution": { "$ref": "#/$defs/resolution" },
        "limitation": { "type": "string" }
      }
    },
    "compositionRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workshop", "definition", "hook", "fromSdk", "toSdk", "fromOrder", "toOrder", "fromOperationId", "toOperationId", "artifact", "resolution"],
      "properties": {
        "kind": { "const": "project-artifact-execution" },
        "workshop": { "type": "string" },
        "definition": { "type": "string" },
        "hook": { "$ref": "#/$defs/hookName" },
        "fromSdk": { "type": "string" },
        "toSdk": { "type": "string" },
        "fromOrder": { "$ref": "#/$defs/nonNegativeInteger" },
        "toOrder": { "$ref": "#/$defs/nonNegativeInteger" },
        "fromOperationId": { "type": "string", "pattern": "^op-[0-9]{4,}$" },
        "toOperationId": { "type": "string", "pattern": "^op-[0-9]{4,}$" },
        "artifact": { "$ref": "#/$defs/value" },
        "resolution": { "$ref": "#/$defs/resolution" }
      }
    },
    "documentDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdk", "code", "severity", "message"],
      "properties": {
        "sdk": { "type": "string" },
        "hook": { "$ref": "#/$defs/hookName" },
        "code": { "type": "string" },
        "severity": { "$ref": "#/$defs/severity" },
        "phase": { "type": "string" },
        "message": { "type": "string" },
        "location": { "$ref": "#/$defs/location" },
        "incomplete": { "type": "boolean" }
      }
    },
    "sdkDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "$ref": "#/$defs/severity" },
        "phase": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "resolutionState": {
      "type": "string",
      "enum": [
        "Resolved",
        "NotResolved",
        "DownloadFailed",
        "DigestMismatch",
        "UnsupportedPlatform",
        "InvalidArtifact"
      ]
    },
    "resolution": {
      "type": "string",
      "enum": ["Resolved", "PartiallyResolved", "Unknown"]
    },
    "evidenceDerivation": {
      "type": "string",
      "enum": ["direct", "inferred", "unresolved"]
    },
    "reachability": {
      "type": "string",
      "enum": ["Unreachable", "Unknown"]
    },
    "operationKind": {
      "type": "string",
      "enum": [
        "command-invocation",
        "assignment",
        "pipeline",
        "redirect-read",
        "redirect-write",
        "command-substitution",
        "process-substitution",
        "function-declaration",
        "function-invocation",
        "source",
        "eval",
        "control-flow"
      ]
    },
    "hookName": {
      "type": "string",
      "enum": ["setup-base", "setup-project", "check-health", "save-state", "restore-state"]
    },
    "severity": {
      "type": "string",
      "enum": ["warning", "error"]
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "freeFormObject": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
